# Copy to .env and adjust. .env is gitignored — real values never get committed.

# VNC password. Required — if unset, wayvnc runs with NO authentication,
# which is fine for a quick local test but not for anything reachable off localhost.
VNC_PASSWORD=changeme

# Host port to publish the VNC server on.
VNC_PORT=5900

# Host port to publish the noVNC web UI on (browser VNC client, no native app needed —
# proxies the same wayvnc session as VNC_PORT above, just over HTTP+WebSocket instead of
# raw RFB). Visit http://localhost:<this port>/vnc.html once running.
VNC_WEB_PORT=6080

# Hardware-accelerated VNC encoding (wayvnc's own --gpu: DMA-BUF capture + VAAPI H.264).
# Off by default. This is NOT what gives Roblox Studio/labwc their GPU acceleration —
# that comes from the /dev/dri passthrough and is always on; this only affects how the
# VNC screen itself is captured and encoded.
#
# Turning it on is harmless but often does nothing, because H.264 is only used when the
# *client* negotiates it. Over the browser (noVNC) that needs a secure context (HTTPS, or
# localhost) — over plain HTTP the browser has no WebCodecs decoder to offer at all — and
# a browser/GPU combination whose H.264 decoder passes noVNC's own probe. Measured on an
# AMD host (2026-08-25): Chrome failed that probe even over HTTPS, so noVNC stayed on
# software `tight` encoding with --gpu enabled. Worth trying, not worth assuming.
#VNC_GPU=true

# Starting screen size, WIDTHxHEIGHT, before any VNC client asks for its own window size.
# Roblox Studio's Wine virtual desktop follows either way, about two seconds behind.
#DESKTOP_RESOLUTION=1920x1080

# --- Remote MCP bridge (optional, see SETUP.md's "Studio MCP over the network") ---
# Lets a remote MCP client reach Roblox Studio's built-in MCP server (stdio-only and
# same-machine-only by design) through this container. supervisord's mcp-bridge program
# starts the bridge whenever MCP_TOKEN is non-empty and idles when it isn't — leave it
# commented out (unset) to skip the bridge entirely, same as leaving VNC_PASSWORD unset
# skips VNC auth.
#
# Running alongside code-docker? MCP_TOKEN belongs in *code-docker's* .env, not this file
# (an included compose file reads the top-level project's .env first, this one only as a
# fallback) — and its ootb.sh/migrate.sh generate it for you without asking, printing the
# value as they do (the real capability gate there is Studio's own Assistant toggle, not
# this token, so a y/N in front of it would only cost you a working install). The
# bridge is then reached at studio:8787 through studio-front, not a host port —
# MCP_PORT below publishes nothing in that mode. See code-docker's own
# docs/tips/roblox-studio.md.

# Host port to publish the MCP bridge (Caddy, bearer-token gated) on.
MCP_PORT=8787

# Bearer token remote MCP clients must send. Generate with: openssl rand -hex 32
# Treat this like a credential — the MCP tools it gates can execute arbitrary Luau code
# inside Roblox Studio (see research/roblox-mcp.md §5.4). Deliberately left commented
# out (not a "changeme" placeholder like VNC_PASSWORD above) — an uncommented weak
# default here would silently auto-start the bridge with a guessable token.
#MCP_TOKEN=

# Optional override for the stdio command that launches Studio's built-in MCP server
# process. Defaults to /usr/local/bin/studio-mcp-stdio.sh (bakes in the resolved,
# tested-working command — see that script's own header comment) — leave unset unless
# you have a specific reason to point at something else.
#STUDIO_MCP_STDIO_CMD=

# --- code-docker integration only: ports Studio may open toward code-docker ---
# With code-docker, Studio sits on its own network and studio-front forwards only these
# ports to code-docker (rojo serve, luau-lsp's Studio plugin, ...). Space-separated ports
# or start-end ranges (34880-34881 are studio-sync's); 8787 is taken by the MCP bridge in
# the other direction. Like MCP_TOKEN, set it in code-docker's .env. See CLAUDE.md's
# "Studio's own network".
#STUDIO_CODE_DOCKER_PORTS=34872-34881 3667

# --- code-docker integration only: studio-sync's Studio plugin ---
# The overlay installs studio-sync's plugin into Studio's Plugins folder on every boot
# (and removes it when this is false). Set in code-docker's .env. See CLAUDE.md's
# "studio-sync".
#STUDIO_SYNC_PLUGIN=true
