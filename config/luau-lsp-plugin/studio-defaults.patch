--- a/plugin/src/init.server.luau
+++ b/plugin/src/init.server.luau
@@ -80,6 +80,22 @@
 	lspManager:autoConnect()
 end
 
+-- roblox-studio-docker: keep trying while startAutomatically is on. Studio here runs for
+-- days, and the language server only exists while a VS Code window is open, so a single
+-- attempt at Studio's start almost never finds it.
+local retrying = true
+plugin.Unloading:Connect(function()
+	retrying = false
+end)
+task.spawn(function()
+	while retrying do
+		task.wait(10)
+		if settings:get("startAutomatically") and not lspManager:isConnected() then
+			lspManager:autoConnect()
+		end
+	end
+end)
+
 --- Clean up connections when the plugin is unloaded.
 plugin.Unloading:Connect(function()
 	lspManager:unload()
