#!/usr/bin/env python3
"""Sync a Rojo project into Roblox Studio once, then disconnect.

Runs the project's own `rojo serve` (whatever version mise or PATH gives in the project
directory) for the length of one sync, under a temporary wrapper project whose name
carries the request. The StudioSync plugin in Studio finds it, claims it, runs Rojo's
initial sync, and reports back here. Nothing in the repository is written.

Every sync uses the same two ports, 34880 for `rojo serve` and 34881 for the reply, so
the plugin only has to watch one port (each probe of a closed port adds a few lines to
Studio's log). Concurrent runs queue on the reply port: whoever binds it goes next.
Both are in the range roblox-studio-front forwards from Studio (STUDIO_CODE_DOCKER_PORTS);
34872-34879 stay free for ordinary `rojo serve`.

Instances the sync owns get an AgentOwner attribute; a sync that would change another
owner's instances is refused. `--release` clears an owner's AgentOwner marks everywhere in
the open place (the instances stay); it needs no project or Rojo.
"""
import argparse
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
import threading
import time
import urllib.request
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

SERVE_PORT, REPLY_PORT = 34880, 34881
# The Rojo protocol of the plugin built into the image (Dockerfile's ROJO_VERSION).
PLUGIN_PROTOCOL = 5


def default_owner(project_dir):
    owner = os.environ.get("STUDIO_SYNC_OWNER")
    if not owner:
        # symbolic-ref, not rev-parse: it also names a branch with no commits yet.
        branch = subprocess.run(
            ["git", "-C", project_dir, "symbolic-ref", "--quiet", "--short", "HEAD"],
            capture_output=True, text=True,
        ).stdout.strip()
        owner = branch or os.path.basename(project_dir)
    return clean_owner(owner)


def clean_owner(owner):
    # ASCII only: the plugin's Lua pattern ([%w%._/%-]) knows nothing else, and an owner
    # it can't parse is a request it never answers.
    return re.sub(r"[^\w./-]", "-", owner, flags=re.ASCII)


def take_turn(handler, seconds):
    """Binds the reply port, waiting while another studio-sync holds it."""
    deadline = time.monotonic() + seconds
    waiting = False
    while True:
        try:
            return ThreadingHTTPServer(("0.0.0.0", REPLY_PORT), handler)
        except OSError:
            if time.monotonic() > deadline:
                sys.exit(f"studio-sync: port {REPLY_PORT} stayed busy for {seconds:g}s - another studio-sync "
                         "still running, or something else is using it")
            if not waiting:
                print("studio-sync: another sync is running, waiting for it to finish...", file=sys.stderr)
                waiting = True
            time.sleep(0.5)


def rojo_command():
    if os.environ.get("ROJO"):
        return [os.environ["ROJO"]]
    if shutil.which("rojo"):
        return ["rojo"]
    if shutil.which("mise"):
        return ["mise", "exec", "--", "rojo"]
    sys.exit("studio-sync: no rojo on PATH (and no mise to find one)")


class Reply:
    def __init__(self):
        self.claimed_by = None
        self.result = None
        self.done = threading.Event()


def make_handler(reply):
    class Handler(BaseHTTPRequestHandler):
        def do_POST(self):
            body = json.loads(self.rfile.read(int(self.headers.get("Content-Length", 0))) or b"{}")
            if self.path == "/claim":
                if reply.claimed_by is None:
                    reply.claimed_by = body.get("place", "?")
                    self.send_response(200)
                else:
                    self.send_response(409)
            elif self.path == "/result":
                reply.result = body
                reply.done.set()
                self.send_response(200)
            else:
                self.send_response(404)
            self.end_headers()

        def log_message(self, *args):
            pass

    return Handler


def wait_for_server(port, process, seconds):
    """Returns /api/rojo's body once `rojo serve` answers, None if it never does."""
    deadline = time.monotonic() + seconds
    while time.monotonic() < deadline:
        if process.poll() is not None:
            return None
        try:
            with urllib.request.urlopen(f"http://127.0.0.1:{port}/api/rojo", timeout=1) as response:
                return response.read()
        except OSError:
            time.sleep(0.2)
    return None


def release_info(name):
    """/api/rojo's answer for a release request, in msgpack like Rojo 7.7's: a one-entry
    map {projectName: name}, which is all the plugin reads before claiming."""
    data = name.encode()
    key = b"projectName"
    if len(data) < 32:
        value = bytes([0xa0 | len(data)]) + data
    elif len(data) < 256:
        value = bytes([0xd9, len(data)]) + data
    else:
        value = b"\xda" + len(data).to_bytes(2, "big") + data
    return b"\x81" + bytes([0xa0 | len(key)]) + key + value


def serve_release_request(name):
    body = release_info(name)

    class Handler(BaseHTTPRequestHandler):
        def do_GET(self):
            if self.path != "/api/rojo":
                self.send_response(404)
                self.end_headers()
                return
            self.send_response(200)
            self.send_header("Content-Type", "application/msgpack")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)

        def log_message(self, *args):
            pass

    try:
        server = ThreadingHTTPServer(("0.0.0.0", SERVE_PORT), Handler)
    except OSError:
        sys.exit(f"studio-sync: port {SERVE_PORT} is taken by something other than studio-sync")
    threading.Thread(target=server.serve_forever, daemon=True).start()
    return server


def wait_for_reply(reply, seconds, what):
    if reply.done.wait(seconds):
        return
    if reply.claimed_by is None:
        sys.exit(f"studio-sync: no Studio picked this up within {seconds:g}s - is Studio running with "
                 "a place open and the StudioSync plugin installed (and its HTTP permission allowed)?")
    sys.exit(f"studio-sync: {reply.claimed_by} claimed the {what} but didn't finish within {seconds:g}s")


def release(owner, args):
    reply = Reply()
    server = take_turn(make_handler(reply), args.timeout)
    threading.Thread(target=server.serve_forever, daemon=True).start()
    request = serve_release_request(f"studio-sync release owner={owner} reply={REPLY_PORT}")
    try:
        print(f"studio-sync: releasing what {owner} owns, waiting for Studio...", file=sys.stderr)
        wait_for_reply(reply, args.timeout, "release")
    finally:
        request.shutdown()
        server.shutdown()

    result = reply.result
    if args.json:
        print(json.dumps(result, ensure_ascii=False, indent=2))
    elif result.get("ok"):
        released = result.get("released") or []
        print(f"released {len(released)} instance(s) owned by {owner} in {result.get('place')}"
              + (": " + ", ".join(released) if released else ""))
    else:
        print(f"studio-sync: {result.get('error', 'failed')}", file=sys.stderr)
    return 0 if result.get("ok") else 1


def protocol_problem(info):
    """Why the plugin can't sync from this server, or None. Rojo up to 7.6 answers in
    JSON with protocol 4; from 7.7 in msgpack, where protocolVersion is a fixstr key
    followed by a fixint."""
    try:
        version = json.loads(info).get("protocolVersion")
    except ValueError:
        marker = b"\xafprotocolVersion"
        at = info.find(marker)
        version = info[at + len(marker)] if at >= 0 and at + len(marker) < len(info) else None
    if version == PLUGIN_PROTOCOL:
        return None
    return (f"this project's rojo speaks Rojo protocol {version}, and the StudioSync plugin speaks "
            f"{PLUGIN_PROTOCOL} (Rojo 7.7 or later) - pin a newer rojo in the project")


def place_restrictions(project):
    """servePlaceIds/blockedPlaceIds from the real project. Rojo reads them only from the
    project it serves, which is the wrapper, so they have to be copied over."""
    try:
        with open(project) as f:
            real = json.load(f)
    except (OSError, ValueError):
        print("studio-sync: couldn't read the project as plain JSON; any servePlaceIds in it "
              "are not enforced", file=sys.stderr)
        return {}
    return {key: real[key] for key in ("servePlaceIds", "blockedPlaceIds") if key in real}


def main():
    parser = argparse.ArgumentParser(description=__doc__.split("\n\n")[0])
    parser.add_argument("project", nargs="?", default="default.project.json",
                        help="Rojo project file (default: default.project.json)")
    parser.add_argument("--owner", help="AgentOwner name (default: $STUDIO_SYNC_OWNER, else the git branch)")
    parser.add_argument("--timeout", type=float, default=60, help="seconds to wait for Studio (default 60)")
    parser.add_argument("--json", action="store_true", help="print the plugin's result as JSON")
    parser.add_argument("--release", action="store_true",
                        help="clear this owner's AgentOwner marks in Studio instead of syncing")
    args = parser.parse_args()

    if args.release:
        return release(clean_owner(args.owner) if args.owner else default_owner(os.getcwd()), args)

    project = os.path.abspath(args.project)
    if not os.path.isfile(project):
        sys.exit(f"studio-sync: no project file at {project}")
    project_dir = os.path.dirname(project)
    owner = clean_owner(args.owner) if args.owner else default_owner(project_dir)

    reply = Reply()
    server = take_turn(make_handler(reply), args.timeout)
    threading.Thread(target=server.serve_forever, daemon=True).start()

    work = tempfile.mkdtemp(prefix="studio-sync-")
    wrapper = os.path.join(work, "studio-sync.project.json")
    with open(wrapper, "w") as f:
        json.dump({"name": f"studio-sync owner={owner} reply={REPLY_PORT}", "tree": {"$path": project},
                   **place_restrictions(project)}, f)

    log = open(os.path.join(work, "rojo.log"), "w+")
    rojo = subprocess.Popen(
        rojo_command() + ["serve", wrapper, "--address", "0.0.0.0", "--port", str(SERVE_PORT)],
        cwd=project_dir, stdout=log, stderr=subprocess.STDOUT,
    )
    try:
        info = wait_for_server(SERVE_PORT, rojo, 30)
        if info is None:
            log.seek(0)
            sys.exit(f"studio-sync: rojo serve didn't come up:\n{log.read().strip()}")
        problem = protocol_problem(info)
        if problem:
            sys.exit(f"studio-sync: {problem}")
        print(f"studio-sync: serving {os.path.relpath(project)} as {owner} on :{SERVE_PORT}, waiting for Studio...",
              file=sys.stderr)
        wait_for_reply(reply, args.timeout, "sync")
    finally:
        rojo.terminate()
        try:
            rojo.wait(5)
        except subprocess.TimeoutExpired:
            rojo.kill()
        server.shutdown()
        shutil.rmtree(work, ignore_errors=True)

    result = reply.result
    if args.json:
        print(json.dumps(result, ensure_ascii=False, indent=2))
    elif result.get("ok"):
        unapplied = result.get("unapplied") or 0
        print(f"synced into {result.get('place')} as {owner}: "
              f"+{result.get('added', 0)} ~{result.get('updated', 0)} -{result.get('removed', 0)}"
              + (f", {unapplied} change(s) could not be applied" if unapplied else ""))
        if result.get("owned"):
            print("owned: " + ", ".join(result["owned"]))
    else:
        print(f"studio-sync: {result.get('error', 'failed')}", file=sys.stderr)
    return 0 if result.get("ok") else 1


if __name__ == "__main__":
    sys.exit(main())
