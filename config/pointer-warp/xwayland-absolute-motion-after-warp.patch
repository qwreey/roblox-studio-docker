+/*
+ * An absolute-only pointer (one whose motion comes without
+ * zwp_relative_pointer_v1 motion in the same frame, such as a VNC or RDP
+ * server's virtual pointer) only knows where the pointer is on the remote
+ * viewer's side.  A client that captures the pointer by warping it back to
+ * an anchor after every move and reads each move as the distance from that
+ * anchor (a 3D viewport's camera, typically) would then read the viewer's
+ * whole distance from the anchor on every event instead of the distance
+ * just moved, and spin faster the further the drag goes.
+ *
+ * So once a client has warped the pointer, apply the device's movement
+ * since its previous event to where the warp left the pointer, and keep
+ * doing so while a button is held, since the client may warp only once
+ * for several events.  The first event after that takes the device's own
+ * position again.
+ *
+ * "Held" is abs_motion.buttons, kept from the wl_pointer button events
+ * themselves.  The device's buttonsDown read 0 here all through a drag
+ * (buttons are queued on get_pointer_device(), not necessarily this device,
+ * and processed later), so a drag started without moving since the
+ * previous one - after a release whose motion event used up the warp -
+ * began with a jump from the client's anchor to the viewer's pointer.
+ */
+static void
+xwl_seat_follow_client_warp(struct xwl_seat *xwl_seat, int *x, int *y)
+{
+    DeviceIntPtr dev = xwl_seat->pointer;
+    Bool held = xwl_seat->abs_motion.buttons != 0;
+    int dx = *x - xwl_seat->abs_motion.last_x;
+    int dy = *y - xwl_seat->abs_motion.last_y;
+    int cx, cy;
+
+    xwl_seat->abs_motion.relative = xwl_seat->abs_motion.valid &&
+        (xwl_seat->abs_motion.warped ||
+         (xwl_seat->abs_motion.relative && held));
+    xwl_seat->abs_motion.valid = TRUE;
+    xwl_seat->abs_motion.warped = FALSE;
+    xwl_seat->abs_motion.last_x = *x;
+    xwl_seat->abs_motion.last_y = *y;
+
+    if (!xwl_seat->abs_motion.relative)
+        return;
+
+    miPointerGetPosition(dev, &cx, &cy);
+    *x = cx + dx;
+    *y = cy + dy;
+}
+
+/*
+ * The compositor sends relative motion alone for an absolute-only device
+ * while the pointer is locked (there is no position to send then).  Count it
+ * into the device's last position, or the next absolute event would apply the
+ * same movement a second time.  A device that sends both kinds of motion is
+ * a relative one (a mouse), which needs none of this.
+ */
+static void
+xwl_seat_follow_relative_motion(struct xwl_seat *xwl_seat, Bool has_absolute)
+{
+    struct xwl_screen *xwl_screen = xwl_seat->xwl_screen;
+    double dx = xwl_seat->pending_pointer_event.dx;
+    double dy = xwl_seat->pending_pointer_event.dy;
+
+    if (has_absolute) {
+        xwl_seat->abs_motion.valid = FALSE;
+        return;
+    }
+
+    dx *= xwl_screen->global_surface_scale;
+    dy *= xwl_screen->global_surface_scale;
+    dx *= xwl_seat->focus_window->viewport_scale_x;
+    dy *= xwl_seat->focus_window->viewport_scale_y;
+
+    xwl_seat->abs_motion.last_x += (int) dx;
+    xwl_seat->abs_motion.last_y += (int) dy;
+}
+
+/*
+ * Xwayland keeps its warp emulator's pointer lock up for as long as the
+ * cursor stays hidden, and a locked pointer moves by relative motion alone.
+ * With a relative device that is all there is to it.  With an absolute-only
+ * one the pointer is then left wherever the client's last warp put it: a
+ * client that draws its own cursor (so the X cursor is hidden throughout)
+ * and warps only while a button drags its camera would, after the drag,
+ * have the pointer trail the viewer's by the length of that drag until
+ * something else took the lock down.
+ *
+ * So tell when the client has stopped capturing the pointer; the caller
+ * then drops the lock and puts the pointer back at the device's own
+ * position:
+ *  - a client that only warped with a button held (a drag) is done
+ *    BUTTON_SETTLE_MS after the last button is up, on a timer, or it would
+ *    show its own cursor where the drag began until the viewer moved again;
+ *  - one that warps with no button held (mouse-look) is done once motion
+ *    has gone WARP_ANSWER_MS without a warp answering it.  Counting from
+ *    the motion rather than from the last warp keeps a pause in the motion
+ *    from ending it, whether the client warps every frame or only when the
+ *    pointer moved.
+ *
+ * Neither is decided within BUTTON_SETTLE_MS of a button event.  A client
+ * goes on reading motion as its drag for a moment after the release (until
+ * its next frame) and would take the pointer's way back for one more, long,
+ * move of its camera; and a warp it makes right after the release is not
+ * mouse-look.
+ *
+ * A lock that is up for a hidden cursor's confinement is left alone: that
+ * client reads relative motion and need not warp at all.
+ */
+#define WARP_ANSWER_MS 500
+#define BUTTON_SETTLE_MS 200
+
+void
+xwl_seat_client_warped_pointer(struct xwl_seat *xwl_seat)
+{
+    xwl_seat->abs_motion.warped = TRUE;
+    xwl_seat->abs_motion.waiting = FALSE;
+
+    if (!xwl_seat->abs_motion.buttons &&
+        GetTimeInMillis() - xwl_seat->abs_motion.button_time >= BUTTON_SETTLE_MS)
+        xwl_seat->abs_motion.look = TRUE;
+}
+
+static Bool
+xwl_seat_warp_capture_idle(struct xwl_seat *xwl_seat)
+{
+    return xwl_seat->abs_motion.valid &&
+        !xwl_seat->abs_motion.buttons &&
+        GetTimeInMillis() - xwl_seat->abs_motion.button_time >= BUTTON_SETTLE_MS &&
+        !xwl_seat->cursor_confinement_window;
+}
+
+static Bool
+xwl_seat_warp_capture_ended(struct xwl_seat *xwl_seat)
+{
+    CARD32 now = GetTimeInMillis();
+
+    if (!xwl_seat_warp_capture_idle(xwl_seat))
+        return FALSE;
+
+    if (!xwl_seat->abs_motion.look)
+        return TRUE;
+
+    /* Motion that moved nothing is nothing for the client to answer. */
+    if (xwl_seat->pending_pointer_event.dx == 0 &&
+        xwl_seat->pending_pointer_event.dy == 0)
+        return FALSE;
+
+    if (!xwl_seat->abs_motion.waiting) {
+        xwl_seat->abs_motion.waiting = TRUE;
+        xwl_seat->abs_motion.waiting_since = now;
+    }
+
+    return now - xwl_seat->abs_motion.waiting_since >= WARP_ANSWER_MS;
+}
+
+static void
+xwl_seat_end_warp_capture(struct xwl_seat *xwl_seat)
+{
+    ValuatorMask mask;
+
+    xwl_seat_destroy_pointer_warp_emulator(xwl_seat);
+    xwl_seat->abs_motion.warped = FALSE;
+    xwl_seat->abs_motion.relative = FALSE;
+
+    valuator_mask_zero(&mask);
+    valuator_mask_set(&mask, 0, xwl_seat->abs_motion.last_x);
+    valuator_mask_set(&mask, 1, xwl_seat->abs_motion.last_y);
+    QueuePointerEvents(xwl_seat->pointer, MotionNotify, 0,
+                       POINTER_ABSOLUTE | POINTER_SCREEN, &mask);
+}
+
+static CARD32
+xwl_seat_settle_timer(OsTimerPtr timer, CARD32 now, void *arg)
+{
+    struct xwl_seat *xwl_seat = arg;
+    CARD32 since = now - xwl_seat->abs_motion.button_time;
+
+    if (!xwl_seat->pointer_warp_emulator || !xwl_seat->pointer ||
+        xwl_seat->abs_motion.buttons || xwl_seat->abs_motion.look)
+        return 0;
+
+    if (since < BUTTON_SETTLE_MS)
+        return BUTTON_SETTLE_MS - since;
+
+    if (xwl_seat_warp_capture_idle(xwl_seat))
+        xwl_seat_end_warp_capture(xwl_seat);
+
+    return 0;
+}
